# --- Target -----------------------------------------------------------
BASE_URL=https://www.century21albania.com/en/properties

# --- Client mode --------------------------------------------------------
# "http" (default, try first) or "browser" (Playwright — only if the
# site needs JS rendering or actively blocks plain HTTP clients)
CLIENT_MODE=browser

# --- HTTP client (aiohttp) ----------------------------------------------
USER_AGENT=Mozilla/5.0 (compatible; GenericScraper/1.0)
REQUEST_TIMEOUT=20.0
VERIFY_SSL=true

# --- Browser client (Playwright) -----------------------------------------
BROWSER_HEADLESS=true
ROTATE_USER_AGENTS=true
SESSION_ROTATE_AFTER=80

# --- Shared pacing / resilience ------------------------------------------
REQUEST_DELAY_MIN_SECS=3.0
REQUEST_DELAY_MAX_SECS=5.0
RETRY_MAX_ATTEMPTS=3
CAPTCHA_COOLDOWN_SECONDS=60.0

# Requests-per-minute cap (HTTP mode only). 0 = disabled.
RATE_LIMIT_RPM=0

# --- Concurrency ----------------------------------------------------------
# HTTP mode can usually go much higher (10-30). Browser mode should
# stay small (3-5) -- each request is a real browser page.
MAX_CONCURRENT_REQUESTS=5

# --- Crawling -------------------------------------------------------------
MAX_PAGES=0
NEXT_PAGE_SELECTOR=a[rel='next']

# --- Output -----------------------------------------------------------------
OUTPUT_DIR=output
CSV_FILENAME=results.csv
JSONL_FILENAME=results.jsonl

CHECKPOINT=output/checkpoint.json
FAILED_URLS=output/failed_urls.json


# --- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE = scraper.log
